class MonteCarloSimulator:
    """Enhanced Monte Carlo simulator for correlated asset prices."""
    
    def __init__(self, tickers: Tuple[str, ...] = ("GC=F", "SI=F"), 
                 labels: Tuple[str, ...] = ("Gold (GC=F)", "Silver (SI=F)")):
        self.tickers = tickers
        self.labels = labels
        self.prices = None
        self.s0 = None
        self.mu = None
        self.sigma = None
        self.corr = None
        self.last_date = None
        
    def download_prices(self, years: int = 3) -> pd.DataFrame:
        """Download historical price data from Yahoo Finance."""
        period = f"{years}y"
        df = yf.download(list(self.tickers), period=period, interval="1d", 
                        auto_adjust=True, progress=False)
        
        if isinstance(df.columns, pd.MultiIndex):
            col = "Close" if "Close" in df.columns.levels[0] else "Adj Close"
            prices = df[col].copy()
        else:
            prices = df.rename(columns={"Close": self.tickers[0]})[[self.tickers[0]]]
        
        self.prices = prices.dropna()
        return self.prices
    
    def estimate_params(self) -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray, pd.Timestamp]:
        """Estimate GBM parameters from historical data."""
        if self.prices is None:
            raise ValueError("Must download prices first")
        
        rets = np.log(self.prices / self.prices.shift(1)).dropna()
        self.mu = rets.mean().values
        self.sigma = rets.std(ddof=1).values
        self.corr = rets.corr().values
        self.s0 = self.prices.iloc[-1].values
        self.last_date = self.prices.index[-1]
        
        return self.s0, self.mu, self.sigma, self.corr, self.last_date
    
    def estimate_jump_params(self) -> Dict[str, float]:
        """Estimate jump diffusion parameters from historical data."""
        if self.prices is None:
            raise ValueError("Must download prices first")
        
        rets = np.log(self.prices / self.prices.shift(1)).dropna()
        
        # Identify jumps as returns beyond 3 standard deviations
        jump_threshold = 3
        jumps = {}
        
        for i, ticker in enumerate(self.tickers):
            col_rets = rets.iloc[:, i]
            threshold = jump_threshold * col_rets.std()
            jump_events = np.abs(col_rets) > threshold
            
            n_jumps = jump_events.sum()
            lambda_j = n_jumps / len(col_rets)  # jump intensity (daily)
            
            if n_jumps > 0:
                jump_returns = col_rets[jump_events]
                mu_j = jump_returns.mean()
                sigma_j = jump_returns.std()
            else:
                mu_j = 0.0
                sigma_j = 0.01
            
            jumps[ticker] = {
                'lambda': lambda_j,
                'mu_j': mu_j,
                'sigma_j': sigma_j,
                'n_jumps': int(n_jumps)
            }
        
        return jumps
    
    def simulate_gbm(self, n_steps: int, n_sims: int = 20000, seed: int = 42) -> np.ndarray:
        """Simulate paths using correlated Geometric Brownian Motion."""
        rng = np.random.default_rng(seed)
        
        # Cholesky decomposition for correlation
        L = np.linalg.cholesky(self.corr)
        
        # Generate correlated standard normals
        z = rng.standard_normal(size=(n_steps, n_sims, len(self.tickers)))
        z_corr = z @ L.T
        
        # GBM in log space
        drift = (self.mu - 0.5 * self.sigma**2)
        increments = drift + self.sigma * z_corr
        
        log_s0 = np.log(self.s0)
        log_paths = log_s0 + np.cumsum(increments, axis=0)
        paths = np.exp(log_paths)
        
        return paths
    
    def simulate_jump_diffusion(self, n_steps: int, n_sims: int = 20000, 
                                seed: int = 42, jump_params: Dict = None) -> np.ndarray:
        """Simulate paths using Jump Diffusion model (Merton)."""
        rng = np.random.default_rng(seed)
        
        # Start with GBM component
        L = np.linalg.cholesky(self.corr)
        z = rng.standard_normal(size=(n_steps, n_sims, len(self.tickers)))
        z_corr = z @ L.T
        
        # Adjust drift for jump component: mu - 0.5*sigma^2 - lambda*E[J-1]
        drift_adjustment = np.zeros(len(self.tickers))
        for i, ticker in enumerate(self.tickers):
            jp = jump_params[ticker]
            expected_jump = jp['lambda'] * (np.exp(jp['mu_j'] + 0.5 * jp['sigma_j']**2) - 1)
            drift_adjustment[i] = expected_jump
        
        drift = (self.mu - 0.5 * self.sigma**2 - drift_adjustment)
        diffusion = drift + self.sigma * z_corr
        
        # Add jump component
        jumps = np.zeros((n_steps, n_sims, len(self.tickers)))
        for i, ticker in enumerate(self.tickers):
            jp = jump_params[ticker]
            # Poisson process for jump occurrences
            jump_occurs = rng.random(size=(n_steps, n_sims)) < jp['lambda']
            # Jump sizes (log-normal)
            jump_sizes = rng.normal(jp['mu_j'], jp['sigma_j'], size=(n_steps, n_sims))
            jumps[:, :, i] = jump_occurs * jump_sizes
        
        # Combine diffusion and jumps
        log_s0 = np.log(self.s0)
        log_paths = log_s0 + np.cumsum(diffusion + jumps, axis=0)
        paths = np.exp(log_paths)
        
        return paths
    
    def calculate_risk_metrics(self, paths: np.ndarray, 
                               trading_days: int = 252) -> pd.DataFrame:
        """Calculate comprehensive risk metrics from simulated paths."""
        terminal = paths[-1, :, :]  # Terminal prices
        n_steps = paths.shape[0]
        
        metrics = {}
        for i, label in enumerate(self.labels):
            term_prices = terminal[:, i]
            returns = (term_prices - self.s0[i]) / self.s0[i]
            
            # Annualized return
            days_in_sim = n_steps
            years = days_in_sim / trading_days
            annualized_return = np.mean(returns) / years
            annualized_vol = np.std(returns) / np.sqrt(years)
            
            metrics[label] = {
                'Mean Price': np.mean(term_prices),
                'Median Price': np.median(term_prices),
                'Std Dev': np.std(term_prices),
                'VaR 95%': self.s0[i] - np.percentile(term_prices, 5),
                'VaR 99%': self.s0[i] - np.percentile(term_prices, 1),
                'CVaR 95%': self.s0[i] - np.mean(term_prices[term_prices <= np.percentile(term_prices, 5)]),
                'CVaR 99%': self.s0[i] - np.mean(term_prices[term_prices <= np.percentile(term_prices, 1)]),
                'Sharpe Ratio': annualized_return / annualized_vol if annualized_vol > 0 else 0,
                'Prob Gain': np.mean(term_prices > self.s0[i]) * 100,
                'Max Drawdown %': self._calculate_max_drawdown(paths[:, :, i], self.s0[i])
            }
        
        return pd.DataFrame(metrics).T
    
    def _calculate_max_drawdown(self, asset_paths: np.ndarray, s0: float) -> float:
        """Calculate average maximum drawdown across all paths."""
        running_max = np.maximum.accumulate(asset_paths, axis=0)
        drawdowns = (asset_paths - running_max) / running_max * 100
        max_drawdowns = np.min(drawdowns, axis=0)
        return np.mean(max_drawdowns)


class Visualizer:
    """Handles visualization of simulation results."""
    
    @staticmethod
    def plot_fanchart_matplotlib(paths: np.ndarray, s0: np.ndarray, 
                                horizon_months: int, labels: Tuple[str, ...]):
        """Create fan charts using matplotlib."""
        n_steps = paths.shape[0]
        x = np.arange(1, n_steps + 1)
        
        quantiles = [0.05, 0.25, 0.50, 0.75, 0.95]
        q_vals = {q: np.quantile(paths, q, axis=1) for q in quantiles}
        
        for asset_idx, label in enumerate(labels):
            plt.figure(figsize=(10, 6))
            plt.plot(x, q_vals[0.50][:, asset_idx], label='Median', linewidth=2, color='darkblue')
            plt.fill_between(x, q_vals[0.25][:, asset_idx], q_vals[0.75][:, asset_idx], 
                           alpha=0.3, label='25th-75th percentile', color='steelblue')
            plt.fill_between(x, q_vals[0.05][:, asset_idx], q_vals[0.95][:, asset_idx], 
                           alpha=0.15, label='5th-95th percentile', color='lightblue')
            plt.axhline(s0[asset_idx], linestyle="--", linewidth=1.5, color='red', 
                       label=f'Start Price: ${s0[asset_idx]:.2f}')
            plt.title(f"{label} Monte Carlo Fan Chart — {horizon_months} months", fontsize=14, fontweight='bold')
            plt.xlabel("Trading days into future", fontsize=12)
            plt.ylabel("Simulated price ($)", fontsize=12)
            plt.legend(loc='best')
            plt.grid(True, alpha=0.3)
            plt.tight_layout()
            plt.show()
    
    @staticmethod
    def plot_fanchart_plotly(paths: np.ndarray, s0: np.ndarray, 
                            horizon_months: int, labels: Tuple[str, ...], 
                            output_dir: Optional[Path] = None):
        """Create interactive fan charts using Plotly."""
        if not PLOTLY_AVAILABLE:
            print("Plotly not available. Falling back to matplotlib.")
            Visualizer.plot_fanchart_matplotlib(paths, s0, horizon_months, labels)
            return
        
        n_steps = paths.shape[0]
        x = np.arange(1, n_steps + 1)
        
        quantiles = [0.01, 0.05, 0.25, 0.50, 0.75, 0.95, 0.99]
        q_vals = {q: np.quantile(paths, q, axis=1) for q in quantiles}
        
        for asset_idx, label in enumerate(labels):
            fig = go.Figure()
            
            # Add percentile bands
            fig.add_trace(go.Scatter(
                x=x, y=q_vals[0.05][:, asset_idx],
                mode='lines', line=dict(width=0), showlegend=False,
                hovertemplate='Day %{x}<br>5th Percentile: $%{y:.2f}<extra></extra>'
            ))
            fig.add_trace(go.Scatter(
                x=x, y=q_vals[0.95][:, asset_idx],
                mode='lines', line=dict(width=0), fillcolor='rgba(68, 114, 196, 0.15)',
                fill='tonexty', name='5th-95th Percentile',
                hovertemplate='Day %{x}<br>95th Percentile: $%{y:.2f}<extra></extra>'
            ))
            
            fig.add_trace(go.Scatter(
                x=x, y=q_vals[0.25][:, asset_idx],
                mode='lines', line=dict(width=0), showlegend=False,
                hovertemplate='Day %{x}<br>25th Percentile: $%{y:.2f}<extra></extra>'
            ))
            fig.add_trace(go.Scatter(
                x=x, y=q_vals[0.75][:, asset_idx],
                mode='lines', line=dict(width=0), fillcolor='rgba(68, 114, 196, 0.3)',
                fill='tonexty', name='25th-75th Percentile',
                hovertemplate='Day %{x}<br>75th Percentile: $%{y:.2f}<extra></extra>'
            ))
            
            # Median line
            fig.add_trace(go.Scatter(
                x=x, y=q_vals[0.50][:, asset_idx],
                mode='lines', line=dict(color='darkblue', width=2.5),
                name='Median Projection',
                hovertemplate='Day %{x}<br>Median: $%{y:.2f}<extra></extra>'
            ))
            
            # Starting price line
            fig.add_trace(go.Scatter(
                x=[1, n_steps], y=[s0[asset_idx], s0[asset_idx]],
                mode='lines', line=dict(color='red', width=2, dash='dash'),
                name=f'Start Price: ${s0[asset_idx]:.2f}',
                hovertemplate='Start Price: $%{y:.2f}<extra></extra>'
            ))
            
            fig.update_layout(
                title=f"{label} Monte Carlo Fan Chart — {horizon_months} Months",
                xaxis_title="Trading Days into Future",
                yaxis_title="Simulated Price ($)",
                hovermode='x unified',
                template='plotly_white',
                height=600,
                font=dict(size=12)
            )
            
            if output_dir:
                output_file = output_dir / f"{label.replace(' ', '_').replace('(', '').replace(')', '')}_fanchart_{horizon_months}m.html"
                fig.write_html(str(output_file))
                print(f"Saved interactive chart: {output_file}")
            
            fig.show()
    
    @staticmethod
    def plot_terminal_distribution(paths: np.ndarray, s0: np.ndarray, labels: Tuple[str, ...]):
        """Plot histogram of terminal prices."""
        terminal = paths[-1, :, :]
        
        fig, axes = plt.subplots(1, len(labels), figsize=(14, 5))
        if len(labels) == 1:
            axes = [axes]
        
        for i, label in enumerate(labels):
            axes[i].hist(terminal[:, i], bins=50, alpha=0.7, color='steelblue', edgecolor='black')
            axes[i].axvline(s0[i], color='red', linestyle='--', linewidth=2, label=f'Start: ${s0[i]:.2f}')
            axes[i].axvline(np.median(terminal[:, i]), color='darkblue', linestyle='-', 
                          linewidth=2, label=f'Median: ${np.median(terminal[:, i]):.2f}')
            axes[i].set_title(f"{label} Terminal Price Distribution", fontweight='bold')
            axes[i].set_xlabel("Price ($)")
            axes[i].set_ylabel("Frequency")
            axes[i].legend()
            axes[i].grid(True, alpha=0.3)
        
        plt.tight_layout()
        plt.show()


class StatisticalTests:
    """Statistical validation and diagnostics."""
    
    @staticmethod
    def test_normality(returns: pd.DataFrame) -> pd.DataFrame:
        """Test normality of returns using Jarque-Bera test."""
        if not SCIPY_AVAILABLE:
            print("SciPy not available. Skipping normality tests.")
            return pd.DataFrame()
        
        results = {}
        for col in returns.columns:
            jb_stat, jb_pval = stats.jarque_bera(returns[col].dropna())
            results[col] = {
                'JB Statistic': jb_stat,
                'JB p-value': jb_pval,
                'Normal?': 'Yes' if jb_pval > 0.05 else 'No',
                'Skewness': stats.skew(returns[col].dropna()),
                'Kurtosis': stats.kurtosis(returns[col].dropna())
            }
        
        return pd.DataFrame(results).T
    
    @staticmethod
    def summarize_terminal(paths: np.ndarray, labels: Tuple[str, ...]) -> pd.DataFrame:
        """Summarize terminal price distribution."""
        terminal = paths[-1, :, :]
        qs = [0.01, 0.05, 0.10, 0.25, 0.50, 0.75, 0.90, 0.95, 0.99]
        out = {}
        
        for i, name in enumerate(labels):
            out[name] = {f"p{int(q*100):02d}": float(np.quantile(terminal[:, i], q)) for q in qs}
            out[name]["mean"] = float(np.mean(terminal[:, i]))
            out[name]["std"] = float(np.std(terminal[:, i]))
        
        return pd.DataFrame(out)


def run_scenario_analysis(simulator: MonteCarloSimulator, n_steps: int, n_sims: int = 10000):
    """Run bull/base/bear scenario analysis."""
    print("\n" + "="*70)
    print("SCENARIO ANALYSIS")
    print("="*70)
    
    scenarios = {
        'Bear': (simulator.mu - 0.5 * simulator.sigma, simulator.sigma * 1.3),
        'Base': (simulator.mu, simulator.sigma),
        'Bull': (simulator.mu + 0.5 * simulator.sigma, simulator.sigma * 0.8)
    }
    
    original_mu = simulator.mu.copy()
    original_sigma = simulator.sigma.copy()
    
    results = {}
    for scenario_name, (mu, sigma) in scenarios.items():
        simulator.mu = mu
        simulator.sigma = sigma
        paths = simulator.simulate_gbm(n_steps, n_sims, seed=42)
        terminal = paths[-1, :, :]
        
        results[scenario_name] = {}
        for i, label in enumerate(simulator.labels):
            results[scenario_name][label] = {
                'median': np.median(terminal[:, i]),
                'mean': np.mean(terminal[:, i]),
                'p05': np.percentile(terminal[:, i], 5),
                'p95': np.percentile(terminal[:, i], 95)
            }
    
    # Restore original parameters
    simulator.mu = original_mu
    simulator.sigma = original_sigma
    
    # Print results
    for label in simulator.labels:
        print(f"\n{label}:")
        print(f"  {'Scenario':<10} {'Median':<12} {'Mean':<12} {'5th %ile':<12} {'95th %ile':<12}")
        print(f"  {'-'*58}")
        for scenario_name in ['Bear', 'Base', 'Bull']:
            r = results[scenario_name][label]
            print(f"  {scenario_name:<10} ${r['median']:>10.2f} ${r['mean']:>10.2f} ${r['p05']:>10.2f} ${r['p95']:>10.2f}")


def main():
    """Main execution function."""
    parser = argparse.ArgumentParser(description='Enhanced Monte Carlo Simulation for Gold & Silver')
    parser.add_argument('--tickers', nargs='+', default=['GC=F', 'SI=F'], help='Asset tickers')
    parser.add_argument('--years', type=int, default=3, help='Years of historical data')
    parser.add_argument('--n-sims', type=int, default=20000, help='Number of simulations')
    parser.add_argument('--horizons', type=str, default='8,12,16', help='Forecast horizons in months (comma-separated)')
    parser.add_argument('--model', choices=['gbm', 'jump'], default='gbm', help='Model type')
    parser.add_argument('--interactive', action='store_true', help='Use interactive Plotly charts')
    parser.add_argument('--scenario-analysis', action='store_true', help='Run scenario analysis')
    parser.add_argument('--output-dir', type=str, help='Directory for saving outputs')
    
    args = parser.parse_args()
    
    # Setup
    tickers = tuple(args.tickers)
    labels = tuple([f"{t.replace('=F', '').replace('GC', 'Gold').replace('SI', 'Silver')} ({t})" 
                   for t in tickers])
    horizons_months = [int(h.strip()) for h in args.horizons.split(',')]
    trading_days_per_month = 21
    
    output_dir = Path(args.output_dir) if args.output_dir else None
    if output_dir:
        output_dir.mkdir(parents=True, exist_ok=True)
    
    # Initialize simulator
    print("="*70)
    print("ENHANCED MONTE CARLO SIMULATION FOR COMMODITIES")
    print("="*70)
    print(f"Model: {args.model.upper()}")
    print(f"Simulations: {args.n_sims:,}")
    print(f"Assets: {', '.join(labels)}")
    print("="*70)
    
    simulator = MonteCarloSimulator(tickers=tickers, labels=labels)
    
    # Download and estimate parameters
    print("\nDownloading historical data...")
    simulator.download_prices(years=args.years)
    s0, mu, sigma, corr, last_date = simulator.estimate_params()
    
    print(f"\nUsing last available prices from: {last_date.date()}")
    print(f"Start prices: {', '.join([f'{l}=${p:.2f}' for l, p in zip(labels, s0)])}")
    print("\nEstimated (daily) log-return parameters from history:")
    for i, lab in enumerate(labels):
        print(f"  {lab}: μ={mu[i]:.6f}, σ={sigma[i]:.6f}")
    print("\nEstimated return correlation matrix:")
    print(pd.DataFrame(corr, index=labels, columns=labels).round(3))
    
    # Statistical tests
    print("\n" + "="*70)
    print("STATISTICAL DIAGNOSTICS")
    print("="*70)
    returns = np.log(simulator.prices / simulator.prices.shift(1)).dropna()
    normality_results = StatisticalTests.test_normality(returns)
    if not normality_results.empty:
        print("\nNormality Tests (Jarque-Bera):")
        print(normality_results.round(4))
    
    # Jump parameters if using jump diffusion
    jump_params = None
    if args.model == 'jump':
        print("\n" + "="*70)
        print("JUMP DIFFUSION PARAMETERS")
        print("="*70)
        jump_params = simulator.estimate_jump_params()
        for ticker, jp in jump_params.items():
            print(f"\n{ticker}:")
            print(f"  Jump intensity (λ): {jp['lambda']:.6f} (daily)")
            print(f"  Jump mean (μ_J): {jp['mu_j']:.6f}")
            print(f"  Jump std (σ_J): {jp['sigma_j']:.6f}")
            print(f"  Historical jumps detected: {jp['n_jumps']}")
    
    # Run simulations for each horizon
    for hm in horizons_months:
        n_steps = int(hm * trading_days_per_month)
        
        print("\n" + "="*70)
        print(f"HORIZON: {hm} months (~{n_steps} trading days)")
        print("="*70)
        
        # Simulate paths
        if args.model == 'jump' and jump_params:
            paths = simulator.simulate_jump_diffusion(n_steps, args.n_sims, seed=42 + hm, 
                                                     jump_params=jump_params)
        else:
            paths = simulator.simulate_gbm(n_steps, args.n_sims, seed=42 + hm)
        
        # Summary statistics
        summary = StatisticalTests.summarize_terminal(paths, labels)
        print("\nTerminal Price Quantiles:")
        print(summary.round(2))
        
        # Risk metrics
        risk_metrics = simulator.calculate_risk_metrics(paths)
        print("\nRisk Metrics:")
        print(risk_metrics.round(2))
        
        # Save to CSV
        if output_dir:
            summary.to_csv(output_dir / f'summary_{hm}m.csv')
            risk_metrics.to_csv(output_dir / f'risk_metrics_{hm}m.csv')
        
        # Visualizations
        if args.interactive and PLOTLY_AVAILABLE:
            Visualizer.plot_fanchart_plotly(paths, s0, hm, labels, output_dir)
        else:
            Visualizer.plot_fanchart_matplotlib(paths, s0, hm, labels)
        
        # Terminal distribution (only for first horizon to avoid too many plots)
        if hm == horizons_months[0]:
            Visualizer.plot_terminal_distribution(paths, s0, labels)
    
    # Scenario analysis
    if args.scenario_analysis:
        n_steps_base = int(12 * trading_days_per_month)  # Use 12-month horizon
        run_scenario_analysis(simulator, n_steps_base, n_sims=10000)
    
    print("\n" + "="*70)
    print("SIMULATION COMPLETE")
    print("="*70)


if __name__ == "__main__":
    main()
